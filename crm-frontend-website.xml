.preview-card {
  background-color: var(--bg-white);
  border: 2px dashed var(--accent-cyan);
  border-radius: var(--radius-md);
  padding: 2.8rem 2.4rem;
  @include flex-col(1.6rem);
  box-shadow: var(--shadow-md);
}

.preview-header {
  @include flex-between;
}

.preview-avatar {
  width: 4.8rem;
  height: 4.8rem;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent-cyan), var(--accent-pink));
  color: var(--text-light);
  font-size: 1.5rem;
  font-weight: 700;
  @include flex-center;
}

.preview-stars {
  display: flex;
  gap: 0.2rem;
}

.preview-description {
  font-size: 1.4rem;
  color: var(--text-dark);
  line-height: 1.7;
  font-style: italic;
  min-height: 7rem;
}

.preview-footer {
  @include flex-col(0.4rem);
  padding-top: 1.2rem;
  border-top: 1px solid var(--bg-light);
}

.preview-name {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--text-dark);
}

.preview-role {
  font-size: 1.2rem;
  color: var(--text-grey);
}

.preview-date {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 1.2rem;
  color: var(--text-grey);
  margin-top: 0.4rem;
}

.preview-hint {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  font-size: 1.3rem;
  color: var(--text-grey);
  padding-left: 0.4rem;
}

// =====================
// SUCCESS STATE
// =====================

.success-section {
  background: linear-gradient(135deg, var(--main-navy) 0%, var(--main-navy-light) 100%);
  min-height: calc(100vh - 8rem);
  @include flex-center;
  padding: 4rem 2rem;
