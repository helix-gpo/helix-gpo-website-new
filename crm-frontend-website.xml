  label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-dark);

    &.warning {
      color: var(--toastr-error);
    }
  }
}

.form-input,
.form-textarea {
  font-family: inherit;
  font-size: 1.5rem;
  color: var(--text-dark);
  background-color: var(--bg-light);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 1.2rem 1.6rem;
