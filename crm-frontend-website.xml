            autoWindowOpen: { autoOpen: false, openDelay: 2 },
            borderRadius: "rounded",
          },
          tooltip: {
            showTooltip: ${!isMobile},
            tooltipMessage: "Brauchst du Hilfe?",
            tooltipBackgroundColor: "#fc03d5",
            tooltipTextColor: "#efefef",
            tooltipFontSize: 16,
          },
          chatWindow: {
            borderRadiusStyle: "rounded",
            avatarBorderRadius: 6,
            messageBorderRadius: 6,
            showTitle: true,
            title: "Helix GPO Website Assistent",
            titleAvatarSrc: "images/chatbot/ai.svg",
            avatarSize: 32,
            welcomeMessage: "Hallo und willkommen bei Helix GPO! Ich bin dein virtueller Assistent. Wie kann ich dir heute helfen?",
            errorMessage: "Ein unerwarteter Fehler ist aufgetreten. Bitte versuche es später erneut!",
            backgroundColor: "#ffffff",
            height: ${isMobile ? Math.round(window.innerHeight * 0.75) : 600},
            width: ${isMobile ? Math.round(window.innerWidth - 32) : 400},
            fontSize: 16,
            starterPrompts: ["Informationen", "Angebote", "Email"],
            starterPromptFontSize: 16,
            renderHTML: false,
            clearChatOnReload: false,
            showScrollbar: false,
            botMessage: {
              backgroundColor: "#0d1424",
              textColor: "#ffffff",
              showAvatar: true,
              avatarSrc: "images/chatbot/ai-dark.png",
              showCopyToClipboardIcon: false,
            },
            userMessage: {
              backgroundColor: "#fc03d5",
              textColor: "#ffffff",
              showAvatar: true,
              avatarSrc: "images/chatbot/user.png",
            },
            textInput: {
              placeholder: "Type your query",
              backgroundColor: "#ffffff",
              textColor: "#1e1e1f",
              sendButtonColor: "#fc03d5",
              maxChars: 200,
              maxCharsWarningMessage: "Du kannst nicht mehr als 200 Zeichen eingeben!",
              autoFocus: false,
              borderRadius: 6,
              sendButtonBorderRadius: 50,
            },
            voiceInputConfig: {
              enabled: true,
              maxRecordingTime: 15,
              recordingNotSupportedMessage: "Bitte verwende einen Browser, der die Aufnahme von Audio-Nachrichten unterstützt!",
              microphoneAccessErrorMessage: "Bitte erlaube in deinen Einstellungen das Aufnehmen über das Mikrofon!",
            },
          },
        },
      });
    `;
      document.body.appendChild(script);
    }

    // Trigger 1: nach kurzer Verzögerung, falls der Nutzer nichts tut
    window.addEventListener('load', () => {
      setTimeout(loadHelixChatbot, 4000);
    });

    // Trigger 2: sofort bei erster Interaktion (schneller als der Timer)
    ['scroll', 'click', 'touchstart', 'keydown'].forEach((eventName) => {
      window.addEventListener(eventName, loadHelixChatbot, { once: true, passive: true });
    });
  </script>
