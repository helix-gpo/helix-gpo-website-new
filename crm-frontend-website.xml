    border-color: var(--accent-cyan);
    background-color: var(--bg-white);
    box-shadow: 0 0 0 3px var(--accent-cyan-light);
  }
}

.form-textarea {
  min-height: 12rem;
  resize: vertical;
}

.rating-selector {
  display: flex;
  gap: 0.4rem;
}

.star-button {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  transition: transform 0.15s;

  &:hover {
    transform: scale(1.15);
  }
}

.upload-row {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  flex-wrap: wrap;
}

.upload-button {
  @include button-base;
  background-color: var(--bg-light);
  color: var(--text-dark);
  border: 1px solid var(--border-color);
  padding: 1rem 1.8rem;
  font-size: 1.4rem;
  cursor: pointer;

  &:hover {
    background-color: var(--border-color);
