import { Component, computed, inject, signal } from '@angular/core';
import { Router } from '@angular/router';
import { Meta, Title } from '@angular/platform-browser';
import { Icon } from '../../util/icon/icon';
import { Project } from '../../model/projects/project';
import { Testimonial } from '../../model/testimonials/testimonial';
import { DUMMY_PROJECTS } from '../../data/dummy-projects';

@Component({
  selector: 'app-main',
  imports: [Icon],
  templateUrl: './main.html',
  styleUrl: './main.scss',
})
export class Main {
  private title = inject(Title);
  private meta = inject(Meta);

  constructor(private router: Router) {
    this.title.setTitle('Helix GPO – Digitalisierung & Geschäftsprozessoptimierung aus Neuss');
    this.meta.updateTag({
      name: 'description',
      content:
        'Helix GPO gestaltet die Prozesse Deines Unternehmens effizient, effektiv und digital – durch moderne Geschäftsprozessoptimierung, Automatisierung und KI-Integration in Neuss.',
    });
  }

  // =====================
  // PROJEKTE (Dummy-Daten, bis das Backend steht)
  // =====================

  readonly projects = signal<Project[]>(DUMMY_PROJECTS);

  readonly showAllProjects = signal(false);

  readonly shownProjects = computed(() =>
    this.showAllProjects() ? this.projects() : this.projects().slice(0, 3),
  );

  readonly showAllProjectsText = computed(() =>
    this.showAllProjects() ? 'Weniger Anzeigen' : 'Mehr Anzeigen',
  );

  handleToggleShowAllProjectsButton() {
    this.showAllProjects.update((current) => !current);

    if (!this.showAllProjects()) {
      this.scrollToElementByButton('projects');
    }
  }

  handleProjectDetailsButtonClick(projectId: number) {
    this.router.navigate(['project-details', projectId]).then(() => {
      this.scrollToElementByButton('header');
    });
  }

  // =====================
  // REFERENZEN (Dummy-Daten, bis das Backend steht)
  // =====================

  private readonly dummyTestimonials: Testimonial[] = [
    {
      id: 1,
      description:
        'Die Zusammenarbeit mit Helix GPO war von Anfang an unkompliziert und zielgerichtet. Unsere Prozesse laufen jetzt spürbar effizienter.',
      result: 5,
      creationDate: new Date('2025-11-15'),
      partnerName: 'M. Breuer',
      partnerRole: 'Steuerberater',
      companyName: 'Michael Breuer Steuerberatung',
    },
    {
      id: 2,
      description:
        'Sehr professionelle Beratung mit echtem Verständnis für unsere Branche. Die neue Website hat unsere Sichtbarkeit deutlich verbessert.',
      result: 5,
      creationDate: new Date('2025-10-02'),
      partnerName: 'S. Weiß',
      partnerRole: 'Vorstand',
      companyName: 'Geschwister Weiß-Stiftung',
    },
    {
      id: 3,
      description:
        'Von der Analyse bis zur Umsetzung alles aus einer Hand – und dabei immer erreichbar und auf Augenhöhe kommuniziert.',
      result: 4,
      creationDate: new Date('2025-08-20'),
      partnerName: 'T. Klein',
      partnerRole: 'Geschäftsführer',
      companyName: 'Klein Handwerksbetrieb',
    },
    {
      id: 4,
      description:
        'Die Automatisierung unserer internen Abläufe hat uns enorm viel Zeit gespart. Klare Empfehlung für jedes wachsende Unternehmen.',
      result: 5,
      creationDate: new Date('2025-06-11'),
      partnerName: 'J. Fischer',
      partnerRole: 'Teamleitung Vertrieb',
      companyName: 'Fischer Vertrieb GmbH',
    },
  ];

  readonly testimonials = signal<Testimonial[]>(this.dummyTestimonials);
  readonly ratingArray = [1, 2, 3, 4, 5];
  readonly showLeftTestimonials = signal(true);

  readonly averageRating = computed(() => {
    const all = this.testimonials();
    if (all.length === 0) return 0;
    const sum = all.reduce((acc, t) => acc + t.result, 0);
    return Math.round((sum / all.length) * 10) / 10;
  });

  readonly shownTestimonials = computed(() => {
    const all = this.testimonials();
    return this.showLeftTestimonials() ? all.slice(0, 3) : all.slice(3, 6);
  });

  handleShowLeftPage() {
    this.showLeftTestimonials.set(true);
    this.scrollToElementByButton('testimonials');
  }

  handleShowRightPage() {
    this.showLeftTestimonials.set(false);
    this.scrollToElementByButton('testimonials');
  }

  getInitials(name: string): string {
    return name
      .split(' ')
      .map((part) => part.charAt(0))
      .join('')
      .toUpperCase();
  }

  // =====================
  // ALLGEMEIN
  // =====================

  formatMonthYear(date: Date): string {
    return date.toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });
  }

  scrollToElementByButton(elementId: string) {
    const element = document.getElementById(elementId);
    element?.scrollIntoView({ behavior: 'smooth' });
  }
}
