}

.upload-filename {
  font-size: 1.3rem;
  color: var(--text-grey);
}

.submit-button {
  @include button-base;
  background-color: var(--accent-cyan);
  color: var(--main-navy);
  box-shadow: var(--shadow-cyan);
  margin-top: 0.8rem;

