  background-clip: text;
  color: transparent;
}

.stat-label {
  font-size: 1.3rem;
  color: var(--text-muted);
  max-width: 18rem;
}

// =====================
// HERO VISUAL
// =====================

.hero-visual {
  position: relative;
  @include flex-center;
  min-height: 44rem;

  @include respond(lg) {
    min-height: 32rem;
  }
}

.visual-blob {
  position: absolute;
  width: 40rem;
  height: 40rem;
  background: radial-gradient(circle, rgba(3, 219, 255, 0.15), transparent 70%);
  border-radius: 50%;
  filter: blur(2rem);

  @include respond(lg) {
    width: 28rem;
    height: 28rem;
  }
}

.visual-graphic {
  position: relative;
  width: 42rem;
  height: 42rem;
  animation: rotateSlow 40s linear infinite;

  @include respond(lg) {
    width: 30rem;
    height: 30rem;
  }
}

@keyframes rotateSlow {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.floating-card {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 1.2rem;
  background-color: var(--bg-white);
  border-radius: var(--radius-md);
  padding: 1.4rem 2rem;
  box-shadow: var(--shadow-lg);
  animation: floatCard 4s ease-in-out infinite;

  .material-symbols-rounded {
    font-size: 2.8rem;
    color: var(--accent-cyan);
  }

  .card-title {
    font-size: 1.2rem;
    color: var(--text-grey);
  }

  .card-value {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  &.card-top {
    top: 8%;
    left: -4%;

    @include respond(lg) {
      left: 0;
    }
  }

  &.card-bottom {
    bottom: 10%;
    right: -6%;
    animation-delay: 1.5s;

    .material-symbols-rounded {
      color: var(--accent-pink);
    }

    @include respond(lg) {
      right: 0;
    }
  }

  @include respond(sm) {
    padding: 1rem 1.4rem;

    .card-value {
      font-size: 1.5rem;
    }
  }
}

@keyframes floatCard {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-1rem);
  }
}

// =====================
// DIENSTLEISTUNG
// =====================

.dienstleistung-section {
  @include section-heading;
  background-color: var(--bg-white);
