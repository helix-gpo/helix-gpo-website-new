  // Borders
  --border-color: #e2e5ea;

  // Shadows – weicher & mehrschichtig statt hart
  --shadow-sm: 0 0.2rem 0.6rem rgba(13, 20, 36, 0.06);
  --shadow-md: 0 0.6rem 1.8rem rgba(13, 20, 36, 0.1);
  --shadow-lg: 0 1.2rem 3.2rem rgba(13, 20, 36, 0.16);
  --shadow-cyan: 0 0.8rem 2.4rem rgba(3, 219, 255, 0.25);
  --shadow-pink: 0 0.8rem 2.4rem rgba(252, 3, 213, 0.2);

  // Radius
  --radius-sm: 0.6rem;
