@use '../../../styles/mixins' as *;

// =====================
// HERO
// =====================

.hero-section {
  background: linear-gradient(135deg, var(--main-navy) 0%, var(--main-navy-light) 100%);
  padding: 12rem 0 10rem;
  overflow: hidden;
  position: relative;
}

.hero-container {
  @include container;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 6.4rem;

  @include respond(lg) {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 4.8rem;
  }
}

.hero-eyebrow {
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: 0.1rem;
  text-transform: uppercase;
  color: var(--accent-cyan);
  margin-bottom: 1.6rem;
}

.hero-title {
  font-size: 5.6rem;
  font-weight: 700;
  line-height: 1.15;
  color: var(--text-light);
  margin-bottom: 2.4rem;

  .highlight {
    background: linear-gradient(90deg, var(--accent-cyan), var(--accent-pink));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @include respond(md) {
    font-size: 4rem;
  }
}

.hero-description {
  font-size: 1.8rem;
  line-height: 1.7;
  color: var(--text-muted);
  max-width: 52rem;
  margin-bottom: 3.6rem;

  strong {
    color: var(--text-light);
    font-weight: 600;
  }

  @include respond(lg) {
    margin-inline: auto;
  }
}

.button-links {
  display: flex;
  gap: 1.6rem;
  flex-wrap: wrap;
  margin-bottom: 4.8rem;

  @include respond(lg) {
    justify-content: center;
  }
}

.button-link {
  @include button-base;

  &.starten-link {
    background-color: var(--accent-cyan);
    color: var(--main-navy);
    box-shadow: var(--shadow-cyan);

    &:hover {
      background-color: var(--accent-cyan-hover);
      transform: translateY(-0.2rem);
    }
  }

  &.info-link {
    background-color: transparent;
    color: var(--text-light);
    border: 1px solid var(--main-navy-border);

    &:hover {
      background-color: rgba(255, 255, 255, 0.06);
    }
  }
}

.hero-stats {
  display: flex;
  gap: 4.8rem;

  @include respond(lg) {
    justify-content: center;
  }

  @include respond(sm) {
    flex-direction: column;
    gap: 2rem;
    align-items: center;
  }
}

.stat {
  @include flex-col(0.4rem);

  @include respond(lg) {
    align-items: center;
  }
}

.stat-value {
