<section class="projects-section" id="projects">
  <div class="projects-container">
    <p class="headline-p">Erkunde</p>
    <h1 class="headline-text">Bisherige Projekte</h1>

    <div class="projects-grid">
      @for (project of shownProjects(); track project.id) {
        <div class="project-card">
          <div class="project-image">
            <div class="project-image-placeholder">
              <app-icon [iconName]="'work'" [iconColor]="'#ffffff'" [iconSize]="'4rem'"></app-icon>
            </div>
          </div>
          <div class="project-content">
            <p class="project-title">{{ project.title }}</p>
            <p class="project-description">{{ project.description }}</p>

            <div class="project-tags">
              @for (tag of project.tags; track tag.value) {
                <span class="project-tag" [style.background-color]="tag.color">{{
                  tag.value
                }}</span>
              }
            </div>

            <div class="project-footer">
              <div class="project-date">
                <app-icon
                  [iconName]="'event_upcoming'"
                  [iconColor]="'#0d1424'"
                  [iconSize]="'2rem'"
                ></app-icon>
                <span>{{ formatMonthYear(project.startDate) }}</span>
              </div>
              <button class="details-button" (click)="handleProjectDetailsButtonClick(project.id)">
                Details
              </button>
            </div>
          </div>
        </div>
      }
    </div>

    @if (projects().length > 3) {
      <div class="projects-toggle">
        <button class="toggle-button" (click)="handleToggleShowAllProjectsButton()">
          {{ showAllProjectsText() }}
        </button>
      </div>
    }
  </div>
</section>

<section class="testimonials-section" id="testimonials">
  <div class="testimonials-container">
    <p class="headline-p">Vertraue</p>
    <h1 class="headline-text">Referenzen</h1>

    <p class="testimonials-intro">
      Unsere Kunden bewerten uns im Durchschnitt mit
      <span class="rating-highlight">{{ averageRating() }}</span> von 5 Sternen – basierend auf
      {{ testimonials().length }} verifizierten Erfahrungsberichten!
    </p>

    <div class="testimonials-grid">
      @for (testimonial of shownTestimonials(); track testimonial.id) {
        <div class="testimonial-card">
          <div class="testimonial-header">
            <div class="testimonial-avatar">{{ getInitials(testimonial.partnerName) }}</div>
            <div class="testimonial-stars">
              @for (i of ratingArray; track i) {
                <app-icon
                  [iconName]="'star'"
                  [iconSize]="'1.8rem'"
                  [iconColor]="i > testimonial.result ? '#e2e5ea' : '#fc03d5'"
                ></app-icon>
              }
            </div>
          </div>

          <p class="testimonial-description">"{{ testimonial.description }}"</p>

          <div class="testimonial-footer">
            <p class="testimonial-name">{{ testimonial.partnerName }}</p>
            <p class="testimonial-role">
              {{ testimonial.partnerRole }} · {{ testimonial.companyName }}
            </p>
            <div class="testimonial-date">
              <app-icon
                [iconName]="'calendar_check'"
                [iconColor]="'#868a92'"
                [iconSize]="'1.6rem'"
              ></app-icon>
              <span>{{ formatMonthYear(testimonial.creationDate) }}</span>
            </div>
          </div>
        </div>
      }
    </div>

    @if (testimonials().length > 3) {
      <div class="testimonials-pagination">
        <button
          class="page-dot"
          [class.active]="showLeftTestimonials()"
          (click)="handleShowLeftPage()"
          aria-label="Vorherige Referenzen"
        ></button>
        <button
          class="page-dot"
          [class.active]="!showLeftTestimonials()"
          (click)="handleShowRightPage()"
          aria-label="Nächste Referenzen"
        ></button>
      </div>
    }
  </div>
</section>

<section class="cta-section" id="cta">
