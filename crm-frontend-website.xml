  <script>
    // Chatbot bewusst verzögert laden: erst nach kurzer Verzögerung ODER
    // sobald der Nutzer zum ersten Mal interagiert (scrollen, klicken, tippen).
    // So beeinträchtigt das Widget nicht die initiale Ladezeit/Lighthouse-Werte.
    function loadHelixChatbot() {
      if (window.__helixChatbotLoaded) return;
      window.__helixChatbotLoaded = true;

      const isMobile = window.innerWidth < 600;

      const script = document.createElement('script');
      script.type = 'module';
      script.textContent = `
      import Chatbot from "https://cdn.n8nchatui.com/v1/embed.js";
      Chatbot.init({
        n8nChatUrl: "https://n8n-helix-gpo.com/webhook/cbb0a0c8-94ae-47cf-a0ce-83273df7e67e/chat",
        metadata: {},
        theme: {
          button: {
            backgroundColor: "#0d1424",
            right: ${isMobile ? 16 : 32},
            bottom: ${isMobile ? 16 : 32},
            size: ${isMobile ? 52 : 64},
            iconColor: "#ffffff",
            customIconSrc: "images/chatbot/ai.svg",
            customIconSize: ${isMobile ? 48 : 60},
