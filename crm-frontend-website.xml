    opacity: 0.7;
    cursor: not-allowed;
  }
}

.loading-spinner {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

// =====================
// PREVIEW PANEL
// =====================

.preview-panel {
  position: sticky;
  top: 10rem;
  @include flex-col(1.6rem);

  @include respond(lg) {
    position: static;
