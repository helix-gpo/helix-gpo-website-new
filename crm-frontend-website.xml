    box-shadow: var(--shadow-md);
  }
}

.legal-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2.4rem;

  @include respond(md) {
    grid-template-columns: 1fr;
  }
}

.legal-block {
  background-color: var(--bg-white);
  border-radius: var(--radius-md);
  padding: 3.2rem;
  box-shadow: var(--shadow-md);
  @include flex-col(1.6rem);

  &.full-width {
    grid-column: 1 / -1;
  }

  h2 {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--main-navy);
    padding-bottom: 1.6rem;
    border-bottom: 2px solid var(--bg-light);
  }
}

.legal-content {
  @include flex-col(1rem);

  p {
    font-size: 1.4rem;
    color: var(--text-grey);
    line-height: 1.7;
  }

  &.two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.4rem;

    @include respond(sm) {
      grid-template-columns: 1fr;
    }
  }
}

.legal-name {
  font-weight: 600;
  color: var(--text-dark) !important;
}

.legal-highlight {
  color: var(--accent-cyan-active);
  font-weight: 600;
}
</file>

<file path="src/app/pages/impressum/impressum.ts">
import { Component, inject } from '@angular/core';
import { Router } from '@angular/router';
import { Meta, Title } from '@angular/platform-browser';
import { Icon } from '../../util/icon/icon';

@Component({
  selector: 'app-impressum',
  imports: [Icon],
  templateUrl: './impressum.html',
  styleUrl: './impressum.scss',
})
export class Impressum {
  private router = inject(Router);
  private title = inject(Title);
  private meta = inject(Meta);

  constructor() {
    this.title.setTitle('Impressum - Helix GPO');
    this.meta.updateTag({
      name: 'description',
      content:
        'Impressum und Kontaktangaben der Helix GPO UG (haftungsbeschränkt) & Co. KG aus Neuss.',
    });
    this.meta.updateTag({ name: 'robots', content: 'noindex, follow' });
  }

  handleBackButtonClick() {
    this.router.navigate(['/']);
  }
}
</file>

