@use '../../../styles/mixins' as *;

// =====================
// HERO
// =====================

.feedback-hero {
  background: linear-gradient(135deg, var(--main-navy) 0%, var(--main-navy-light) 100%);
  padding: 9rem 0 8rem;
  position: relative;
  overflow: hidden;

  &::before {
    content: '';
    position: absolute;
    width: 36rem;
    height: 36rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(3, 219, 255, 0.15), transparent 70%);
    top: -14rem;
    right: -10rem;
  }
}

.feedback-hero-container {
  @include container;
  max-width: 72rem;
  position: relative;
  z-index: 1;
}

.hero-back-button {
  width: 4.4rem;
  height: 4.4rem;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.08);
  border: none;
  @include flex-center;
  cursor: pointer;
  margin-bottom: 2.4rem;
  transition: background-color 0.2s;

  &:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }
}

.hero-eyebrow {
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: 0.1rem;
  text-transform: uppercase;
  color: var(--accent-cyan);
  margin-bottom: 1.2rem;
}

.hero-title {
  font-size: 4rem;
  font-weight: 700;
  color: var(--text-light);
  line-height: 1.2;
  margin-bottom: 1.6rem;

  @include respond(sm) {
    font-size: 2.8rem;
  }
}

.hero-subtitle {
  font-size: 1.6rem;
  color: var(--text-muted);
  line-height: 1.6;
  max-width: 48rem;
}

// =====================
// SPLIT LAYOUT
// =====================

.feedback-split {
  background-color: var(--bg-light);
  padding: 6.4rem 0 8rem;
}

.feedback-split-container {
  @include container;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 4.8rem;
  align-items: start;

  @include respond(lg) {
    grid-template-columns: 1fr;
  }
}

// =====================
// FORM PANEL
// =====================

.form-panel {
  background-color: var(--bg-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: 4rem;
  @include flex-col(2.4rem);

  @include respond(sm) {
