@use '../../../styles/mixins' as *;

// =====================
// HERO
// =====================

.case-hero {
  background: linear-gradient(135deg, var(--main-navy) 0%, var(--main-navy-light) 100%);
  padding: 10rem 0 7rem;
  position: relative;
  overflow: hidden;
}

.case-hero-pattern {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1.5px, transparent 1.5px);
  background-size: 2.4rem 2.4rem;
  mask-image: linear-gradient(180deg, black, transparent);
}

.case-hero-container {
  @include container;
  max-width: 90rem;
  position: relative;
  z-index: 1;
}

.hero-back-button {
  width: 4.4rem;
  height: 4.4rem;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.08);
  border: none;
  @include flex-center;
  cursor: pointer;
  margin-bottom: 3.2rem;
  transition: background-color 0.2s;

  &:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }
}

.case-category {
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: 0.08rem;
  text-transform: uppercase;
  color: var(--accent-cyan);
  margin-bottom: 1.2rem;
}

.case-title {
  font-size: 4.4rem;
  font-weight: 700;
  color: var(--text-light);
  line-height: 1.15;
  margin-bottom: 2.4rem;

  @include respond(sm) {
    font-size: 3rem;
  }
}

.case-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
}

.case-tag {
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--text-light);
  padding: 0.6rem 1.6rem;
  border-radius: 50rem;
}

// =====================
// BODY
// =====================

.case-body {
  background-color: var(--bg-white);
  padding: 6.4rem 0 10rem;
}

.case-body-container {
  @include container;
  max-width: 90rem;
  display: grid;
  grid-template-columns: 1fr 32rem;
  gap: 4.8rem;
  align-items: start;

  @include respond(lg) {
    grid-template-columns: 1fr;
  }
}

// Main content

.case-intro {
