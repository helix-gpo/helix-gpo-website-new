          },
          tooltip: {
            showTooltip: ${!isMobile},
            tooltipMessage: "Brauchst du Hilfe?",
            tooltipBackgroundColor: "#fc03d5",
            tooltipTextColor: "#efefef",
            tooltipFontSize: 16,
          },
          chatWindow: {
